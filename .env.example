# ═══════════════════════════════════════════════════════════════════════════
# DMARC Pipeline — environment configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
DMARC_HOST=127.0.0.1
DMARC_PORT=8000

# ── Supabase ───────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
DMARC_SUPABASE_URL=https://xxxxx.supabase.co
DMARC_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs... (long JWT)

# ── Features ────────────────────────────────────────────────────────────────
DMARC_WATCH_FOLDER=true
DMARC_WORKER_COUNT=2
DMARC_MAX_UPLOAD_SIZE_MB=50

# ── Microsoft Outlook (Graph API) ─────────────────────────────────────────
# Get these from: Azure Portal → Azure AD → App registrations → Your app
# Required permissions (Delegated): Mail.Read, User.Read, offline_access
DMARC_MS_CLIENT_ID=your-client-id-here
DMARC_MS_CLIENT_SECRET=your-client-secret-here
DMARC_MS_REDIRECT_URI=http://localhost:8000/outlook/callback
DMARC_MS_TENANT_ID=common

# ── Discord notifications ──────────────────────────────────────────────────
# Create a webhook in your Discord channel: Channel Settings → Integrations → Webhooks
DMARC_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DMARC_DISCORD_ENABLED=false

# ── Logging ─────────────────────────────────────────────────────────────────
DMARC_LOG_LEVEL=INFO
